{
  "meta": {
    "name": "INTENT",
    "version": "2026-11-21",
    "referenceFramePx": { "width": 1080, "height": 2400 },
    "density": "xxhdpi",
    "dpScale": 3,
    "logicalDp": { "width": 360, "height": 800 },
    "unit": "All layout numbers in this spec are dp unless marked sp or px. 1 dp = 3 px on the 1080-wide reference."
  },
  "color": {
    "paper": { "hex": "#F6F4F0", "rgb": [246, 244, 240], "use": "Screen background" },
    "surface": { "hex": "#FFFFFF", "rgb": [255, 255, 255], "use": "Cards, fields, sheets, grouped lists" },
    "surfaceMuted": { "hex": "#F3F0EA", "rgb": [243, 240, 234], "use": "Icon wells, wheel selected disc, inset chips" },
    "brand": { "hex": "#5C4DFF", "rgb": [92, 77, 255], "use": "Primary buttons, active nav, wordmark, selected stroke, links" },
    "brandPressed": { "hex": "#4A3DE0", "rgb": [74, 61, 224], "use": "Primary button pressed" },
    "brandSubtle": { "hex": "#EEEBFF", "rgb": [238, 235, 255], "use": "Selected row wash, user chat bubble" },
    "ink": { "hex": "#161616", "rgb": [22, 22, 22], "use": "Headlines, body, primary icons" },
    "inkSecondary": { "hex": "#5E5A55", "rgb": [94, 90, 85], "use": "Subtitles, helper, inactive body" },
    "inkTertiary": { "hex": "#8A857E", "rgb": [138, 133, 126], "use": "Placeholders, captions, inactive nav, chevrons" },
    "line": { "hex": "#E6E1D8", "rgb": [230, 225, 216], "use": "Hairline borders, dividers, inactive progress" },
    "lineStrong": { "hex": "#D4CEC3", "rgb": [212, 206, 195], "use": "Wheel ticks" },
    "onBrand": { "hex": "#FFFFFF", "rgb": [255, 255, 255], "use": "Text and icons on brand fill" },
    "danger": { "hex": "#B42318", "rgb": [180, 35, 24], "use": "Destructive confirm only. Not used on these screens." },
    "scrim": { "hex": "#161616", "alpha": 0.4, "use": "Behind companion sheet" }
  },
  "type": {
    "family": "Roboto",
    "fallback": "The Android system sans. Do not bundle a custom font.",
    "styles": {
      "display": { "sizeSp": 34, "lineHeightSp": 40, "weight": 700, "trackingEm": -0.02, "color": "ink" },
      "title": { "sizeSp": 28, "lineHeightSp": 34, "weight": 700, "trackingEm": -0.015, "color": "ink" },
      "titleSm": { "sizeSp": 22, "lineHeightSp": 28, "weight": 700, "trackingEm": -0.01, "color": "ink" },
      "section": { "sizeSp": 18, "lineHeightSp": 24, "weight": 600, "color": "ink" },
      "body": { "sizeSp": 16, "lineHeightSp": 24, "weight": 400, "color": "ink" },
      "bodySecondary": { "sizeSp": 16, "lineHeightSp": 24, "weight": 400, "color": "inkSecondary" },
      "bodyMedium": { "sizeSp": 16, "lineHeightSp": 24, "weight": 500, "color": "ink" },
      "button": { "sizeSp": 16, "lineHeightSp": 20, "weight": 600, "color": "onBrand" },
      "link": { "sizeSp": 16, "lineHeightSp": 20, "weight": 600, "color": "brand" },
      "label": { "sizeSp": 14, "lineHeightSp": 20, "weight": 400, "color": "inkSecondary" },
      "caption": { "sizeSp": 13, "lineHeightSp": 18, "weight": 400, "color": "inkTertiary" },
      "overline": { "sizeSp": 12, "lineHeightSp": 16, "weight": 500, "trackingEm": 0.08, "transform": "uppercase", "color": "inkTertiary" },
      "nav": { "sizeSp": 11, "lineHeightSp": 14, "weight": 500, "color": "inkTertiary" },
      "navActive": { "sizeSp": 11, "lineHeightSp": 14, "weight": 600, "color": "brand" },
      "wordmark": { "sizeSp": 18, "lineHeightSp": 22, "weight": 600, "trackingEm": 0.04, "color": "brand" },
      "counter": { "sizeSp": 12, "lineHeightSp": 16, "weight": 400, "color": "inkTertiary" }
    }
  },
  "space": [0, 4, 8, 12, 16, 20, 24, 28, 32, 40, 48, 56, 64],
  "radius": { "sm": 10, "md": 14, "lg": 16, "xl": 20, "pill": 999 },
  "stroke": { "hairline": 1, "selected": 2, "icon": 1.75 },
  "elevation": {
    "none": "0",
    "card": "Do not use a drop shadow on paper. Separate cards with 1 dp line #E6E1D8.",
    "sheet": "Top corners only. No shadow required; the scrim separates it."
  },
  "motion": {
    "durationShortMs": 180,
    "durationMediumMs": 240,
    "easing": "standard decelerate",
    "reducedMotion": "If the system animator scale is 0, snap. Do not convey state by motion alone."
  },
  "layout": {
    "screenPaddingHorizontal": 20,
    "appBarHeight": 56,
    "bottomNavHeight": 64,
    "minTouch": 48,
    "primaryButtonHeight": 52,
    "primaryButtonHeightEmphasis": 56,
    "listRowHeight": 56,
    "icon": 24,
    "iconWell": 40,
    "statusBar": "System. Do not draw a fake status bar."
  }
}
